# PostgreSQL connection string used by Prisma.
# Local dev example: postgresql://USER:PASSWORD@localhost:5432/gradeflow?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/gradeflow?schema=public"

# Random 32+ character secret used to sign session cookies (JWT).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

NODE_ENV="development"
